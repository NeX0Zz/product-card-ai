# Copy to .env and fill in. .env is listed in .gitignore.
OPENROUTER_API_KEY=

# Model routing: OpenRouter tries each chain in order, at most 3 models in a chain.
# The escalation chain handles the last repair if validation keeps failing.
LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling:free,nvidia/nemotron-3.5-lightning:free
LLM_ESCALATION_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,thinkingmachines/inkling:free

# schema: only models with native JSON schema support. prompt: the format is described in the
# prompt, which also allows models without it, including many free ones. Code validates both.
LLM_OUTPUT_MODE=prompt

# allow: free endpoints may log requests, so send no confidential data.
# deny: only providers that do not collect data. Use it with paid models.
LLM_DATA_COLLECTION=allow
# Set to true to allow only Zero Data Retention endpoints (narrows the model pool).
LLM_ZDR=false

# Reasoning models spend tokens on thinking first: none, minimal, low, medium or high.
LLM_REASONING_EFFORT=low

# Total generation attempts per product, including repairs (1-4).
LLM_MAX_ATTEMPTS=3

# Limits of the local web service.
RATE_LIMIT_PER_MINUTE=20
MAX_CONCURRENT_GENERATIONS=4
CACHE_TTL_SECONDS=3600
